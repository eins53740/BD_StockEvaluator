# BD_StockEvaluator — Environment Variables
# Copy this file to .env and fill in the values.

# ── Required in production ──────────────────────────────────
SECRET_KEY=               # Flask session secret — MUST be set in production

# ── LLM API keys (at least one needed for AI opinion reports) ──
GROQ_API_KEY=             # Groq (LLaMA) — primary LLM provider
GEMINI_API_KEY=           # Google Gemini — fallback LLM provider

# ── Optional data sources ───────────────────────────────────
FRED_API_KEY=             # Federal Reserve macro data (optional)

# ── Application settings ────────────────────────────────────
FLASK_DEBUG=0             # Set to 1 only for local development
CORS_ORIGINS=             # Comma-separated allowed origins (default: *)

# ── Background refresh (optional) ──────────────────────────
ENABLE_BACKGROUND_REFRESH=false
REFRESH_TICKERS=          # Comma-separated, e.g. AAPL,MSFT,GOOGL
REFRESH_INTERVAL_MINUTES=180

# ── Docker runtime ──────────────────────────────────────────
DOCKER_RUNTIME=mock       # Set to "live" for real API calls in Docker
