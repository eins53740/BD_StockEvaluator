# BD_StockEvaluator Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# AI API Keys
# ============================================================================
# Groq API Key (for LLaMA 3 models) - Primary AI provider
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_BASE=

# Gemini API Key (for Google Gemini models) - Fallback AI provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash-lite

# ============================================================================
# Data Provider API Keys
# ============================================================================
# FRED (Federal Reserve Economic Data) - For macro indicators
FRED_API_KEY=your_fred_api_key_here

# Financial Modeling Prep
FMP_API_KEY=your_fmp_api_key_here

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ============================================================================
# Application Settings
# ============================================================================
# Flask secret key for session management
SECRET_KEY=change-me-in-production-use-random-string

# API Port (default: 8000 for FastAPI, 5000 for Flask)
API_PORT=8000
FLASK_PORT=5000

# ============================================================================
# Docker Settings
# ============================================================================
# For testing: real or mock Docker runtime
DOCKER_RUNTIME=mock
DOCKER_AVAILABLE=0

# ============================================================================
# API Gateway & Rate Limiting (Epic 9 F9.3)
# ============================================================================
# Rate limit per client (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Enable API key authentication (true/false)
REQUIRE_API_KEY=false

# Valid API keys (comma-separated)
# Generate keys with: python -c "import secrets; print(f'sk_{secrets.token_urlsafe(32)}')"
VALID_API_KEYS=sk_example_key_1,sk_example_key_2

# Default API key for development
DEFAULT_API_KEY=dev-key-123

# ============================================================================
# Logging & Debug
# ============================================================================
FLASK_DEBUG=0
LOG_LEVEL=INFO
